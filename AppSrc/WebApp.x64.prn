38853>>>        tWebNavigateData NavigateData
38853>>>        tWebNavigateData NavigateData
38853>>>        Boolean bHasRecord
38853>>>        Handle hoDD
38853>>>
38853>>>        Get Server to hoDD
38854>>>        Get GetNavigateData to NavigateData
38855>>>        Get HasRecord of hoDD to bHasRecord
38856>>>
38856>>>        // let's hide all buttons and then Show the ones we want
38856>>>        WebSet pbRender of oEditBtn to False
38857>>>        WebSet pbRender of oSaveBtn to False
38858>>>        WebSet pbRender of oCancelChangesBtn to False
38859>>>        WebSet pbRender of oDeleteBtn to False
38860>>>
38860>>>        If (NavigateData.bReadOnly) Begin
38862>>>            WebSet pbRender of oEditBtn to True
38863>>>        End
38863>>>>
38863>>>        Else Begin
38864>>>            WebSet pbRender of oSaveBtn to True
38865>>>            WebSet pbRender of oCancelChangesBtn to True
38866>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38867>>>        End
38867>>>>
38867>>>    End_Procedure
